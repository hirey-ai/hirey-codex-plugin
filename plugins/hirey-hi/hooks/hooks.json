{
  "description": "Checks the authorized Hi inbox summary on foreground turns and offers one local batch reminder when due.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/hirey_inbox_reminder.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/hirey_inbox_reminder.py\"",
            "statusMessage": "Checking Hirey inbox summary",
            "timeout": 15,
            "additionalContextLimit": 3000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/hirey_inbox_reminder.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/hirey_inbox_reminder.py\"",
            "statusMessage": "Checking Hirey inbox summary",
            "timeout": 15,
            "additionalContextLimit": 3000
          }
        ]
      }
    ]
  }
}
